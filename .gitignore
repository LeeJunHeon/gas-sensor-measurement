# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Atomic-write temp files
*.tmp

# PyInstaller 빌드 산출물 (build.spec은 추적 대상)
build/
dist/

# 런타임 생성 폴더
logs/

# 런타임 설정 — 현장마다 다르다(COM 포트·배정·스케일). 저장소가 덮어쓰지 않도록 제외.
#   참고용 기본값은 config.example.json 에 있다.
config.json

# Editors / OS
.vscode/
.idea/
.DS_Store
*.log

# 레시피는 사용자 데이터 — 저장소에 담지 않는다(납품 패키지 오염 방지)
recipes/*.json
!recipes/.gitkeep
